{
	"version": "V2",
	"craftingSystem": {
		"id": "rippers-hoplosphere",
		"details": {
			"name": "Rippers — Harvested Hoplospheres",
			"summary": "Monster material → shards → hoplospheres, plus the accessory setting recipe.",
			"description": "The Lodge’s harvested-hoplosphere economy for Rippers Unmasked. Aspects are essences; shards refine into spheres; matrices set banes; remnants set accessories. Built from the hoplosphere-economy brief (source-faithful; no invented rules values). Some runtime fields (progressive salvage yield, per-system check DLs, Scorch tier bands, the Susurrus gathering environment) are STUBBED pending the installed build’s V3 export envelope — search TODO(V3).",
			"author": "Austin (cubemail.exe) — Rippers Unmasked"
		},
		"disabled": false
	},
	"essences": [
		{
			"id": "algor",
			"name": "Algor",
			"tooltip": "Algor — ice",
			"iconCode": "fa-droplet",
			"disabled": false,
			"description": "The ice register. Lodge term for the aspect that presents as cold. From <em>algor mortis</em>, the cooling of a corpse.",
			"craftingSystemId": "rippers-hoplosphere",
			"activeEffectSourceItemUuid": ""
		},
		{
			"id": "sordes",
			"name": "Sordes",
			"tooltip": "Sordes — poison",
			"iconCode": "fa-droplet",
			"disabled": false,
			"description": "The poison register. Street counterpart: <em>the crust</em>. From <em>sordes</em>, the foul crust on a fever patient’s lips.",
			"craftingSystemId": "rippers-hoplosphere",
			"activeEffectSourceItemUuid": ""
		},
		{
			"id": "inanition",
			"name": "Inanition",
			"tooltip": "Inanition — dark",
			"iconCode": "fa-droplet",
			"disabled": false,
			"description": "The dark register. Street counterpart: <em>the hollow</em>. From <em>inanition</em>, death by emptiness.",
			"craftingSystemId": "rippers-hoplosphere",
			"activeEffectSourceItemUuid": ""
		},
		{
			"id": "empyreuma",
